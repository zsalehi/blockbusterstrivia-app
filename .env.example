# Copy to .env (docker compose) or .env.local (npm run dev). Never commit the real file.

# Public URL of the site, no trailing slash. Used for login/invite links.
SITE_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Postgres (alphanumeric password only, it is embedded in a URL)
POSTGRES_USER=bbt
POSTGRES_PASSWORD=
POSTGRES_DB=bbt
# `npm run dev` outside Docker connects here:
DATABASE_URL=postgres://bbt:CHANGE_ME@localhost:5432/bbt

# Email (Resend). Unset in development: emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=BlockBusters <noreply@blockbusterstrivia.com>

# Caddy (production). Use the bare domain, not a URL.
SITE_ADDRESS=blockbusterstrivia.com
WWW_ADDRESS=www.blockbusterstrivia.com
# Home server via Cloudflare Tunnel: set SITE_ADDRESS=:80 and fill in the token.
TUNNEL_TOKEN=
