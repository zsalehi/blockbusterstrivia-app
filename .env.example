# Copy to .env (docker compose) or .env.local (npm run dev). Never commit the real file.

# Public URL of the site, no trailing slash. Used for login/invite links.
SITE_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Postgres (alphanumeric password only, it is embedded in a URL)
POSTGRES_USER=bbt
POSTGRES_PASSWORD=
POSTGRES_DB=bbt
# `npm run dev` outside Docker connects here:
DATABASE_URL=postgres://bbt:CHANGE_ME@localhost:5432/bbt

# Email. With nothing set in development, emails are printed to the server console.
# Either any SMTP service or Resend. SMTP wins if SMTP_HOST is set.
# Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<mailbox>, SMTP_PASS=<16-char app password>,
# and EMAIL_FROM must use that mailbox (or one of its aliases).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Google Workspace without an app password: set SMTP_USER (the mailbox) plus these three (see docs/unraid.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=BlockBusters <noreply@blockbusterstrivia.com>
# Who is emailed (comma-separated) when a team registers.
REGISTRATION_NOTIFY_TO=info@blockbusterstrivia.com
# Trying the site on a private network without Resend: set true and read login links from `docker compose logs app`.
EMAIL_CONSOLE=false

# Caddy (production). Use the bare domain, not a URL.
SITE_ADDRESS=blockbusterstrivia.com
WWW_ADDRESS=www.blockbusterstrivia.com
# Host ports Caddy listens on. Unraid's own UI uses 80/443, so use 8480/8443 there.
HTTP_PORT=80
HTTPS_PORT=443
# Home server via Cloudflare Tunnel: set SITE_ADDRESS=:80 and fill in the token.
# Keep a test site out of search engines: ROBOTS_TAG=noindex,nofollow (leave as "all" for the real site).
ROBOTS_TAG=all
TUNNEL_TOKEN=
